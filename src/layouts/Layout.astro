---
import { Font } from "astro:assets";
import "@/styles/globals.css";
import { Header } from "@/components/ui/header";
import { LOCALES, getDictionary, type Locale } from "@/lib/i18n";
import { SITE_URL } from "@/lib/site";

interface Props {
  lang: Locale;
  title: string;
  noindex?: boolean;
}

const { lang, title, noindex = false } = Astro.props;
const dict = getDictionary(lang);
const OG_LOCALES: Record<Locale, string> = { en: "en_US", fr: "fr_FR", it: "it_IT" };
const ogImage = `${SITE_URL}/og/${lang}.png`;
---

<!doctype html>
<html lang={lang} class="h-full scroll-smooth antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={dict.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {LOCALES.map((locale) => <link rel="alternate" hreflang={locale} href={`${SITE_URL}/${locale}`} />)}
    <!-- Link previews (WhatsApp, LinkedIn, Discord, Slack...): screenshot of the hero -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nadia Lahya" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={dict.meta.description} />
    <meta property="og:url" content={`${SITE_URL}/${lang}`} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/icon.png" sizes="500x500" type="image/png" />
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-bricolage" preload />
    <!-- Saved theme (src/lib/theme.ts) applied before the first paint, no flash -->
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {
          // storage blocked: fall back to the OS setting
        }
        if (theme !== "light" && theme !== "dark") theme = "system";
        const resolved =
          theme === "system" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : theme;
        document.documentElement.classList.add(resolved);
        document.documentElement.style.colorScheme = resolved;
      })();
    </script>
  </head>
  <body class="min-h-full flex flex-col font-mono text-ink">
    <Header client:load lang={lang} nav={dict.nav} labels={dict.header} />
    <slot />
  </body>
</html>
